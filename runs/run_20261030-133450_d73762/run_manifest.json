     "find": "\tbody.collision_layer = int(b.get(\"layer\", 1))\n\tbody.collision_mask = 0\n\tvar shape := CollisionShape3D.new()\n\tshape.name = \"Shape\"\n\tvar bs := BoxShape3D.new()\n\tbs.size = size\n\tshape.shape = bs\n\tshape.disabled = kind == \"hurdle\"",
